{
  "name": "ts-workflow",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Typed, fluent workflows with sequential steps, branching, parallel execution, and cancellation.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:badges": "npm run test:coverage && jest-coverage-badges",
    "build": "tsup --format cjs,esm --dts",
    "lint": "tsc",
    "debug": "node --inspect-brk ./node_modules/jest/bin/jest -i",
    "test:package": "node scripts/check-package.cjs",
    "check": "npm run lint && npm run test:coverage -- --runInBand && npm run build && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tmarndt1/TsWorkflow.git"
  },
  "author": "Travis Arndt",
  "bugs": {
    "url": "https://github.com/Tmarndt1/TsWorkflow/issues"
  },
  "homepage": "https://github.com/Tmarndt1/TsWorkflow#readme",
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@types/jest": "^27.4.1",
    "@types/node": "^20.4.1",
    "common-js": "^0.3.8",
    "jest": "^27.5.1",
    "jest-coverage-badges": "^1.0.0",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^7.1.0",
    "typescript": "^4.9.5"
  },
  "keywords": [
    "typescript",
    "javascript",
    "workflow",
    "async",
    "parallel",
    "fluent-api"
  ],
  "files": [
    "dist/index.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/"
  ]
}
